{
  "name": "ultimate-job-scraper",
  "version": "0.1.0",
  "private": true,
  "description": "Fast, low-cost job scraper for LinkedIn, Naukri and Glassdoor (Apify Actor)",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
